# Copy to .env and fill in. Do not commit real secrets to git (.env is git-ignored).

# Canonical site origin (drives sitemap.xml, robots.txt, OG/canonical URLs)
VITE_SITE_URL="https://<your-production-domain>"

# Session signing secret — set via `wrangler secret put SESSION_SECRET`
# (not in .env because it's a server secret)
SESSION_SECRET="<random-string>"

# D1 database ID — set after running `wrangler d1 create flash-ar`
D1_DATABASE_ID="<database-id>"

# R2 bucket name for asset storage
R2_BUCKET_NAME="flash-ar-assets"
