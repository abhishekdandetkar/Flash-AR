# Copy to .env and fill in. Do not commit real secrets to git (.env is git-ignored).

# Supabase project (client + server)
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_PUBLISHABLE_KEY=""
# Server-only — never shipped to the client. Required by /api/public/assets/*.
SUPABASE_SERVICE_ROLE_KEY=""

# Canonical site origin (drives sitemap.xml, robots.txt, OG/canonical URLs)
VITE_SITE_URL="https://<your-production-domain>"

# Used by drizzle-kit for schema migrations
DATABASE_URL=""
