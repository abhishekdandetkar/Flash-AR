{
  // Name for the deployed Cloudflare Worker. Nitro merges this with its
  // generated config at build time (.output/server/wrangler.json); all other
  // fields (main, assets, compatibility_date...) are generated by nitro.
  "name": "flash-ar",

  // D1 database — create with: wrangler d1 create flash-ar
  // Then copy the database_id below.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flash-ar",
      "database_id": "DATABASE_ID"
    }
  ],

  // R2 bucket for asset storage — create with: wrangler r2 bucket create flash-ar-assets
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "flash-ar-assets"
    }
  ],

  "compatibility_date": "2026-10-31"
}
